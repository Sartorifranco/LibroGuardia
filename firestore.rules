rules_version = '2';

// Toda la data se accede solo via Cloud Functions (Admin SDK).
// El frontend NO accede directo a Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    // Jobs de auto-detección de hardware (Admin → estación LAN).
    // Pueden contener password del equipo en claro solo hasta el claim
    // (luego se redacta; además hay cleanup programado / expireAt).
    // Cliente NUNCA lee ni escribe: solo Cloud Functions con Admin SDK.
    match /hardware_detect_jobs/{jobId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
