# Secreto para firmar JWT (HS256). Obligatorio, mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generar-un-valor-aleatorio-de-al-menos-32-caracteres>
# Clave para POST /api/setup/initial-users (bootstrap). Si se deja vacía/ausente el endpoint queda deshabilitado.
SETUP_KEY=
UBIKA_API_URL=https://ubika.rastreo.com.ar
UBIKA_API_TOKEN=
# Saltos de proxy confiables para req.ip (1 = Cloud Functions; 2 si todo entra por Firebase Hosting).
TRUST_PROXY=1
